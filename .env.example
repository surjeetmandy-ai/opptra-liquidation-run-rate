# Copy to .env and fill in. .env is git-ignored; never commit a key.

# The real morning brief needs an Anthropic API key (console.anthropic.com). Without it the app
# runs and shows the engine's own verdict instead, and says so.
ANTHROPIC_API_KEY=

# Optional (blank = default)
# LLM_MODEL=claude-sonnet-5-5   # claude-haiku-5-5 is ~20x cheaper and faster; claude-opus-5-5 for more depth
# LLM_EFFORT=medium             # low | medium | high: how much the model reasons before writing
# LLM_TIMEOUT_S=120             # seconds to wait for one attempt
# LOG_LEVEL=INFO
